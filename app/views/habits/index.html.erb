<% content_for :title, "Habits" %>

<h1 class="text-center my-4">My Habits </h1>

<% if not user_signed_in? %>
  <div class="alert alert-info mx-auto" style="max-width: 650px;">
    You're viewing in guest mode. <%= link_to "Sign up", new_user_registration_path %> to:
    <ul class="mb-0">
      <li>Save your habits permanently</li>
      <li>Track your progress over time</li>
      <li>Access your habits from any device</li>
    </ul>
  </div>
<% end %>


<div class="d-flex justify-content-between align-items-center px-3 mb-2" style="max-width: 650px; margin: 0 auto;">
  <%= link_to "Add New Habit", new_habit_path, class: "btn btn-outline-dark" %>
  <p class="mb-0 fs-5 text-muted">Check in for <%= Date.today.strftime("%B %e, %Y") %></p>
</div>
<div class="d-flex justify-content-center">
  <div class="scroll-container rounded p-3 mb-2" style="height: 800px; overflow-y: auto; width: 100%; max-width: 700px">
    <% if @habits.any?  %>
      <div id="habits" class="mb-4 mt-1 me-3 ms-3">
        <% @habits.each do |habit| %>
          <div class="card mb-3">
            <div class="card-body d-flex justify-content-between align-items-center">
              <%= render "habit", habit: habit %>
              <%= render "habit_modal", habit: habit %>
              <%=  render "checkin_form", habit: habit, checked_in: habit.checkins.exists?(user: current_user, date: Date.today) %>
            </div>
          </div>
        <% end %>
      </div>
    <% else %>
       <div class="text-center py-4">
          <p class="text-muted">No habits yet. Create your first habit to get started!</p>
        </div>
    <% end %>
    </div>
  </div>
</div>

